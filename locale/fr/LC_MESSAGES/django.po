msgstr[1] ""
"Votre abonnement se termine dans %(d)s jours. Renouvelez-le pour éviter "
"toute interruption."

msgid "Your access has been suspended"
msgstr "Votre accès a été suspendu"

msgid "License check needed"
msgstr "Vérification de la licence nécessaire"

msgid "Your free trial / subscription has ended"
msgstr "Votre essai gratuit / abonnement est terminé"

msgid "Your license has expired"
msgstr "Votre licence a expiré"

msgid ""
"Your data is safe. Contact us to activate your subscription and continue "
"using GymPro DZ."
msgstr ""
"Vos données sont en sécurité. Contactez-nous pour activer votre abonnement "
"et continuer à utiliser GymPro DZ."

msgid "Check again"
msgstr "Vérifier à nouveau"

msgid "Download a copy of my data"
msgstr "Télécharger une copie de mes données"

msgid "Last check"
msgstr "Dernière vérification"

msgid "Contact the vendor"
msgstr "Contacter le fournisseur"

msgid "Activation key (offline)"
msgstr "Clé d'activation (hors ligne)"

msgid ""
"This computer has not been able to check its license for several days. "
"Connect it to the internet and press “Check again”."
msgstr ""
"Cet ordinateur n'a pas pu vérifier sa licence depuis plusieurs jours. "
"Connectez-le à Internet puis cliquez sur « Vérifier à nouveau »."

msgid "License checked."
msgstr "Licence vérifiée."

msgid "Could not reach the license server. Check the internet connection."
msgstr ""
"Impossible de joindre le serveur de licences. Vérifiez la connexion "
"Internet."

msgid ""
"Hello, I want to activate GymPro DZ. Gym: %(gym)s — Installation ID: %(id)s"
msgstr ""
"Bonjour, je souhaite activer GymPro DZ. Salle : %(gym)s — ID d'installation "
": %(id)s"
